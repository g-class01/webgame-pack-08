# Radical Play - 3D Particle Format
# Options:
# scale(float)
# enableAlpha()
# xgrade(R1,G1,B1,A1,R2,G2,B2,A2)
# ygrade(R1,G1,B1,A1,R2,G2,B2,A2)
# zgrade(R1,G1,B1,A1,R2,G2,B2,A2)

scale(3)
enableAlpha()
midz(0.8)
zgrade(255,64,0,100,255,220,0,255)

v(-0.600000,0.000000,0.000000,0.000000,0.000000,2.000000,-1.000000,0.000000,1.600000,1.000000,0.000000,1.600000,0.600000,0.000000,0.000000)v
p(0,1,2,1,3,4,0,1,4)p

